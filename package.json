{
  "name": "web-stream-player-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapter-first browser player for RTSP gateways, FLV, MPEG-TS, HLS and raw H.264/H.265 streams.",
  "license": "MIT",
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @web-stream-player/playground build",
    "dev": "pnpm --filter @web-stream-player/playground dev",
    "dev:relay": "pnpm --filter @web-stream-player/rtsp-relay dev",
    "samples": "bash scripts/generate-samples.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json && pnpm --filter @web-stream-player/playground typecheck",
    "benchmark:relay": "node benchmarks/relay-clients.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.17.30",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1"
    }
  }
}
