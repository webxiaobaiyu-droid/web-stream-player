{
  "name": "@web-stream-player/mpegts",
  "version": "0.1.0",
  "description": "FLV, MPEG-TS and RTSP relay adapter for Web Stream Player.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mpegts.js": "^1.8.0"
  },
  "peerDependencies": {
    "@web-stream-player/core": "^0.1.0"
  },
  "devDependencies": {
    "@web-stream-player/core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" }
}

