{
  "name": "@web-stream-player/react",
  "version": "0.1.0",
  "description": "React component for Web Stream Player.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-stream-player": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" }
}

