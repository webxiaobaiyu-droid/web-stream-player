{
  "name": "@web-stream-player/rtsp-relay",
  "version": "0.1.0",
  "description": "Shared, no-transcode RTSP to WebSocket MPEG-TS relay.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "web-stream-relay": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts ../../examples/relay/relay.config.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "publishConfig": { "access": "public" }
}

