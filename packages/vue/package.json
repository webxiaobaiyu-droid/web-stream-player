{
  "name": "@web-stream-player/vue",
  "version": "0.1.0",
  "description": "Vue 3 component for Web Stream Player.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external vue --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-stream-player": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" }
}

